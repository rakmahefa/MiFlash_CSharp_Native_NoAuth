<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MiFlash.Core\MiFlash.Core.csproj" />
    <ProjectReference Include="..\MiFlash.Edl\MiFlash.Edl.csproj" />
    <ProjectReference Include="..\MiFlash.Fastboot\MiFlash.Fastboot.csproj" />
    <ProjectReference Include="..\MiFlash.Transport.Usb\MiFlash.Transport.Usb.csproj" />
    <ProjectReference Include="..\MiFlash.Transport.Serial\MiFlash.Transport.Serial.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="i18n/LanguageLibrary.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Nom du binaire publié : « miflash » (cohérent avec la doc CLI
         et les paquets .deb/.rpm/AUR — packaging/nfpm, packaging/aur). -->
    <AssemblyName>miflash</AssemblyName>
    <RootNamespace>MiFlash.Cli</RootNamespace>
  </PropertyGroup>

</Project>
